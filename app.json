{
  "expo": {
    "name": "Helprr",
    "slug": "helprr",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "helprr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mohammadhelaly.helprr",
      "icon": {
        "light": "./assets/brand/ios/app-icon-light.png",
        "dark": "./assets/brand/ios/app-icon-dark.png",
        "tinted": "./assets/brand/ios/app-icon-tinted.png"
      },
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Helprr to access your camera."
      }
    },
    "android": {
      "icon": "./assets/brand/android/app-icon-legacy.png",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/brand/android/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/brand/android/adaptive-icon-background.png",
        "monochromeImage": "./assets/brand/android/adaptive-icon-monochrome.png"
      },
      "package": "com.mohammadhelaly.helprr",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.mohammadhelaly.helprr",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/brand/splash/splash-icon-light.png",
          "imageWidth": 168,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#191919",
            "image": "./assets/brand/splash/splash-icon-dark.png"
          },
          "android": {
            "backgroundColor": "#ffffff",
            "image": "./assets/brand/splash/splash-icon-light.png",
            "imageWidth": 168,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#191919",
              "image": "./assets/brand/splash/splash-icon-dark.png"
            }
          },
          "ios": {
            "backgroundColor": "#ffffff",
            "image": "./assets/brand/splash/splash-icon-light.png",
            "imageWidth": 168,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#191919",
              "image": "./assets/brand/splash/splash-icon-dark.png"
            }
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Helprr to access your microphone.",
          "speechRecognitionPermission": "Allow Helprr to use speech recognition."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "ar"],
            "android": ["en", "ar"]
          }
        }
      ]
    ],
    "extra": {
      "supportsRTL": true
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
